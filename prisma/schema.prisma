// Odwzorowanie .prodready/define/data-model/schema.sql.
// Ograniczenia CHECK oraz indeksy częściowe i wyrażeniowe tabeli connection nie są wyrażalne
// w tym pliku — są dopisane ręcznie w SQL pierwszej migracji (ADR-002).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConnectionKind {
  association
  chain

  @@map("connection_kind")
}

enum NoteColor {
  yellow
  red
  orange
  green
  blue

  @@map("note_color")
}

model Board {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  zones          Zone[]
  notes          Note[]
  connections    Connection[]
  reviewSessions ReviewSession[]

  @@map("board")
}

model Zone {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  name      String   @db.VarChar(60)
  x         Float
  y         Float
  width     Float
  height    Float
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notes Note[]

  @@index([boardId], map: "zone_board_id_idx")
  @@map("zone")
}

model Note {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId    String    @map("board_id") @db.Uuid
  zoneId     String?   @map("zone_id") @db.Uuid
  topic      String    @db.VarChar(500)
  imageWords String?   @map("image_words") @db.VarChar(500)
  story      String?   @db.VarChar(2000)
  emoji      String?   @db.VarChar(64)
  color      NoteColor @default(yellow)
  x          Float
  y          Float
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  board               Board          @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  zone                Zone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  outgoingConnections Connection[]   @relation("connection_source")
  incomingConnections Connection[]   @relation("connection_target")
  reviewResults       ReviewResult[]

  @@index([boardId], map: "note_board_id_idx")
  @@index([zoneId], map: "note_zone_id_idx")
  @@map("note")
}

model Connection {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId      String         @map("board_id") @db.Uuid
  sourceNoteId String         @map("source_note_id") @db.Uuid
  targetNoteId String         @map("target_note_id") @db.Uuid
  kind         ConnectionKind @default(association)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz

  board      Board @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sourceNote Note  @relation("connection_source", fields: [sourceNoteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  targetNote Note  @relation("connection_target", fields: [targetNoteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([boardId], map: "connection_board_id_idx")
  @@map("connection")
}

model PegWord {
  number      String   @id @db.VarChar(15)
  word        String   @db.VarChar(80)
  defaultWord String?  @map("default_word") @db.VarChar(40)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("peg_word")
}

model ReviewSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId    String    @map("board_id") @db.Uuid
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz

  board   Board          @relation(fields: [boardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  results ReviewResult[]

  @@index([boardId, finishedAt], map: "review_session_board_finished_idx")
  @@index([finishedAt], map: "review_session_finished_at_idx")
  @@map("review_session")
}

model ReviewResult {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  noteId     String   @map("note_id") @db.Uuid
  remembered Boolean
  answeredAt DateTime @default(now()) @map("answered_at") @db.Timestamptz

  session ReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  note    Note          @relation(fields: [noteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sessionId, noteId], map: "review_result_session_id_note_id_key")
  @@map("review_result")
}
