# ===========================================
# Application
# ===========================================
NODE_ENV=development
# Port na hoście, pod którym aplikacja jest dostępna w sieci lokalnej
APP_PORT=3000

# ===========================================
# Database (compose.yaml wylicza z nich DATABASE_URL dla kontenera)
# ===========================================
POSTGRES_USER=mnemoboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mnemoboard
# Używane tylko przy uruchamianiu poleceń poza kontenerem (np. prisma na hoście)
DATABASE_URL=postgresql://mnemoboard:change-me@localhost:5432/mnemoboard
DATABASE_URL_TEST=postgresql://mnemoboard:change-me@localhost:5432/mnemoboard_test

# ===========================================
# Authentication
# ===========================================
# Brak w MVP (ADR-003): aplikacja działa wyłącznie w sieci lokalnej.
# Nie wystawiaj portu aplikacji do internetu.
